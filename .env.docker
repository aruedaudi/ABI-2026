# Plantilla para despliegue con Docker (compose.yaml).
# Copia este archivo a .env y ajusta credenciales:  copy .env.docker .env

# ---- Modo de despliegue: development | production ----
# development -> instala dev-deps, APP_DEBUG on, sin cache de config/rutas/vistas
# production  -> composer --no-dev, APP_DEBUG forzado a false, config/route/view cache
APP_MODE=production

APP_NAME=ABI
APP_ENV=development
APP_KEY=base64:7Sph7mJfeMFEDSOzqcU+uMQI2+c0cTXT4YIww8quBhA=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Puerto del host -> contenedor (Apache escucha en 80 dentro del contenedor)
APP_PORT=8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# DB_HOST lo fija compose a "db". Aqui solo el resto.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=root

# Conexiones por rol (config/database.php). El entrypoint crea estos usuarios
# en MySQL a partir de database/sql/roles.sql cuando SETUP_DB_ROLES=true.
DB_USER_USERNAME=db_user
DB_USER_PASS=user_pass
DB_RESEARCH_USER=db_research_staff
DB_RESEARCH_PASS=staff_pass
DB_PROFESSOR_PASS=professor_pass
DB_STUDENT_PASS=student_pass

# Inicializacion controlada por el entrypoint (reemplaza a scripts/set-db-roles.*)
SETUP_DB_ROLES=true
RUN_SEEDERS=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="abi@udi.edu.co"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=80
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
